# Copy to .env and fill in your values.
#   cp env.example .env

# LLM provider (the agent is built on the OpenAI Agents SDK).
OPENAI_API_KEY=
# Silences a harmless tracing 403 from the OpenAI Agents SDK.
OPENAI_AGENTS_DISABLE_TRACING=1

# Rental-system API (mock). Point these at your API deployment.
# The API key for your rental-system API (see docs/api-reference.md).
ROADWAY_API_KEY=
ROADWAY_API_URL=

# Optional settings (defaults shown; uncomment to override)
# MAX_AUTO_CHARGE_USD=500
# MAX_EXTENSION_DAYS=14
# GRACE_PERIOD_MINUTES=30
# SHORT_EXTENSION_MINUTES=30
# QUOTE_TTL_MINUTES=15
# MAX_EMAIL_FAILURES=2
# MAX_PAYMENT_FAILURES=2
# HTTP_CONNECT_TIMEOUT_S=3.0
# HTTP_READ_TIMEOUT_S=10.0
# HTTP_AVAILABILITY_READ_TIMEOUT_S=12.0
# HTTP_MAX_ATTEMPTS=3
# HTTP_BACKOFF_BASE_S=0.5
# HTTP_BACKOFF_CAP_S=4.0
# OPENAI_MODEL=gpt-5.4-mini
# EMBEDDING_MODEL=text-embedding-3-small
# LOG_DIR=logs
# CACHE_DIR=.cache
# KB_PATH=data/knowledge-base/articles.json
